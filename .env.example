# Copy to .env and change the values:  cp .env.example .env
# .env is git-ignored - never commit real credentials.

MINIO_ROOT_USER=fashion-admin
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string

# Bucket
MINIO_BUCKET=fashion-minst-bucket

# Which model the API serves: "latest", an MLflow run id, or a full object key
MODEL_SELECTOR=latest

# Training-complete webhook. Default: the bundled local receiver.
WEBHOOK_URL=http://webhook-receiver:8088/webhook

# Host ports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MLFLOW_PORT=5050
API_PORT=8000
UI_PORT=8501
WEBHOOK_PORT=8088
